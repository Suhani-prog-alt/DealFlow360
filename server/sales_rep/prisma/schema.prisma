generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id              String   @id @default(uuid())
  name            String
  category        String
  price           Float
  discountCeiling Float    // Max allowed discount % without approval
  isSubscription  Boolean  @default(false)
  margin          Float    // Simplified margin indicator

  quotationItems  QuotationItem[]
}

model Quotation {
  id               String   @id @default(uuid())
  customerName     String
  customerTier     String   // Bronze, Silver, Gold
  status           String   // Draft, Pending Approval, Approved, Confirmed
  blendedRiskScore Float?
  totalAmount      Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            QuotationItem[]
}

model QuotationItem {
  id            String    @id @default(uuid())
  quotationId   String
  productId     String
  quantity      Int       @default(1)
  discountGiven Float     @default(0) // % discount applied

  quotation     Quotation @relation(fields: [quotationId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
}

model Warehouse {
  id       String @id @default(uuid())
  name     String
  location String
}
