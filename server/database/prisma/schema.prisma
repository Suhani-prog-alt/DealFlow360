// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SALES_REP
  MANAGER
  FINANCE
  OPERATIONS
  ADMIN
}

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  NEGOTIATION
  ACCEPTED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BackorderStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum NegotiationStatus {
  OPEN
  COUNTER_OFFER
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES_REP)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations         Quotation[]
  approvals          Approval[]         @relation("ApproverApprovals")
  deals              Deal[]             @relation("SalesRepDeals")
  requestedDiscounts DiscountApproval[] @relation("RequestedDiscounts")
  approvedDiscounts  DiscountApproval[] @relation("ApprovedDiscounts")
}

model Customer {
  id          String       @id @default(uuid())
  companyName String
  contactName String?
  email       String       @unique
  phone       String?
  tier        CustomerTier @default(STANDARD)
  address     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations    Quotation[]
  deals         Deal[]         @relation("CustomerDeals")
  orders        Order[]
  negotiations  Negotiation[]
  subscriptions Subscription[]
  invoices      Invoice[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  sku         String  @unique
  category    String
  description String?
  unitPrice   Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory      Inventory[]
  quotationItems QuotationItem[]
  priceListItems PriceListItem[]
  invoiceItems   InvoiceItem[]
  orderItems     OrderItem[]
  negotiations   Negotiation[]
}

model Warehouse {
  id       String @id @default(uuid())
  name     String
  location String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory    Inventory[]
  fulfillments Fulfillment[]
}

model Inventory {
  id               String @id @default(uuid())
  productId        String
  warehouseId      String
  quantity         Int    @default(0)
  reservedQuantity Int    @default(0)
  reorderLevel     Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model Quotation {
  id          String @id @default(uuid())
  quoteNumber String @unique
  customerId  String
  createdById String

  status QuotationStatus @default(DRAFT)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  items        QuotationItem[]
  approvals    Approval[]
  orders       Order[]
  negotiations Negotiation[]

  @@index([customerId])
  @@index([createdById])
  @@index([status])
}

model QuotationItem {
  id          String @id @default(uuid())
  quotationId String
  productId   String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  requestedDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  approvedDiscountPercent  Decimal @default(0) @db.Decimal(5, 2)

  finalPrice Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model PriceList {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PriceListItem[]
}

model PriceListItem {
  id          String  @id @default(uuid())
  priceListId String
  productId   String
  price       Decimal @db.Decimal(12, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
}

model DiscountTier {
  id           String       @id @default(uuid())
  name         String
  customerTier CustomerTier

  minDiscount Decimal @db.Decimal(5, 2)
  maxDiscount Decimal @db.Decimal(5, 2)

  approvalLevel Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRule {
  id           String   @id @default(uuid())
  name         String
  minDiscount  Decimal  @db.Decimal(5, 2)
  maxDiscount  Decimal  @db.Decimal(5, 2)
  requiredRole UserRole
  priority     Int      @default(1)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals Approval[]

  @@index([minDiscount, maxDiscount])
  @@index([requiredRole])
}

model Approval {
  id             String         @id @default(uuid())
  quotationId    String
  approvalRuleId String
  approverId     String?
  status         ApprovalStatus @default(PENDING)
  comments       String?

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?

  quotation    Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approvalRule ApprovalRule @relation(fields: [approvalRuleId], references: [id])
  approver     User?        @relation("ApproverApprovals", fields: [approverId], references: [id])

  history ApprovalHistory[]

  @@index([quotationId])
  @@index([approvalRuleId])
  @@index([approverId])
  @@index([status])
}

model ApprovalHistory {
  id          String         @id @default(uuid())
  approvalId  String
  action      ApprovalStatus
  comments    String?
  performedBy String
  createdAt   DateTime       @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@index([performedBy])
}

enum DealStatus {
  DRAFT
  QUOTED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum DiscountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Deal {
  id          String     @id @default(uuid())
  customerId  String
  salesRepId  String
  status      DealStatus @default(DRAFT)
  totalAmount Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customer         Customer          @relation("CustomerDeals", fields: [customerId], references: [id])
  salesRep         User              @relation("SalesRepDeals", fields: [salesRepId], references: [id])
  billing          Billing?
  discountApproval DiscountApproval?
}

model DiscountApproval {
  id          String                 @id @default(uuid())
  dealId      String                 @unique
  requestedBy String
  approvedBy  String?
  status      DiscountApprovalStatus @default(PENDING)
  discountPct Decimal                @db.Decimal(5, 2)
  reason      String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  deal      Deal  @relation(fields: [dealId], references: [id])
  requester User  @relation("RequestedDiscounts", fields: [requestedBy], references: [id])
  approver  User? @relation("ApprovedDiscounts", fields: [approvedBy], references: [id])
}

model Billing {
  id             String   @id @default(uuid())
  dealId         String   @unique
  subtotal       Decimal  @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deal     Deal      @relation(fields: [dealId], references: [id])
  invoices Invoice[]
}

model Invoice {
  id String @id @default(uuid())

  invoiceNumber String @unique

  // Existing Billing connection
  billingId String?

  // New Phase 6 connections
  customerId     String
  subscriptionId String?
  orderId        String?

  status InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billing      Billing?      @relation(fields: [billingId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@index([billingId])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([status])
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoiceId  String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod String?
  status        PaymentStatus @default(SUCCESS)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  quotationId String @unique
  customerId  String

  status OrderStatus @default(DRAFT)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])

  items        OrderItem[]
  fulfillments Fulfillment[]
  backorders   Backorder[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([quotationId])
  @@index([status])
}

model OrderItem {
  id String @id @default(uuid())

  orderId   String
  productId String

  quantity Int

  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  finalPrice      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  fulfillmentItems FulfillmentItem[]
  backorders       Backorder[]

  @@index([orderId])
  @@index([productId])
}

model Fulfillment {
  id String @id @default(uuid())

  fulfillmentNumber String @unique

  orderId     String
  warehouseId String

  status FulfillmentStatus @default(PENDING)

  shippingAddress String?

  shippedAt   DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  items FulfillmentItem[]

  @@index([orderId])
  @@index([warehouseId])
  @@index([status])
}

model FulfillmentItem {
  id String @id @default(uuid())

  fulfillmentId String
  orderItemId   String

  quantity Int

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id])

  @@index([fulfillmentId])
  @@index([orderItemId])
}

model Backorder {
  id String @id @default(uuid())

  orderId     String
  orderItemId String

  quantity Int
  reason   String?

  status BackorderStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
}

model Negotiation {
  id String @id @default(uuid())

  quotationId String
  customerId  String

  status NegotiationStatus @default(OPEN)

  requestedDiscountPercent Decimal  @db.Decimal(5, 2)
  offeredDiscountPercent   Decimal? @db.Decimal(5, 2)

  customerMessage String?
  salesRepMessage String?

  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id])
  product   Product?  @relation(fields: [productId], references: [id])
  productId String?

  @@index([quotationId])
  @@index([customerId])
  @@index([status])
}

model SubscriptionPlan {
  id String @id @default(uuid())

  name        String
  description String?

  price           Decimal         @db.Decimal(12, 2)
  billingInterval BillingInterval

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())

  subscriptionNumber String @unique

  customerId String
  planId     String

  status SubscriptionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  nextBillingDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer         @relation(fields: [customerId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  billingSchedules BillingSchedule[]
  invoices         Invoice[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
}

model BillingSchedule {
  id String @id @default(uuid())

  subscriptionId String

  billingDate DateTime
  amount      Decimal  @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([billingDate])
  @@index([status])
}
